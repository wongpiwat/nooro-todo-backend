{
  "version": 2,
  "name": "nooro-todo-backend",
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/.*",
      "dest": "src/app.ts",
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    }
  ]
}
